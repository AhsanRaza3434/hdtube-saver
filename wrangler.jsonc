{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hdtube-saver",
  "main": "./worker.js",
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": "./dist/hdtube-saver",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
